@@ -76,11 +76,11 @@ struct ccdigest_info {
     /* the initial state of the hash */
     const void *initial_state;
 
-    void (*compress)(ccdigest_state_t state,
+    void (*CC_SPTR(ccdigest_info, compress))(ccdigest_state_t state,
                      size_t nblocks,
                      const void *in);
 
-    void (*final)(const struct ccdigest_info *di,
+    void (*CC_SPTR(ccdigest_info, final))(const struct ccdigest_info *di,
                   ccdigest_ctx_t ctx,
                   void *digest);
 
