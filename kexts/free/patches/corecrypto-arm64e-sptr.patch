diff --git a/cc/include/corecrypto/cc_config.h b/cc/include/corecrypto/cc_config.h
index e32f0d3..753e64e 100644
--- a/cc/include/corecrypto/cc_config.h
+++ b/cc/include/corecrypto/cc_config.h
@@ -235,4 +235,20 @@
     #define CC_SMALL_CODE 0
 #endif
 
+
+/*
+ * xnulinux: function pointers in the structures the kernel shares with corecrypto (digest and mode descriptors, the
+ * kernel PRNG's function table) are signed on arm64e kernels as Apple's corecrypto headers declare them (CC_SPTR), so
+ * the kernel's authenticated calls through them check out.
+ */
+#ifndef CC_SPTR
+#if __has_feature(ptrauth_calls) && defined(KERNEL)
+#include <ptrauth.h>
+#define CC_SPTR(_sn_, _n_) \
+    __ptrauth(ptrauth_key_process_independent_code, 1, ptrauth_string_discriminator("cc_" #_sn_ #_n_)) _n_
+#else
+#define CC_SPTR(_sn_, _n_) _n_
+#endif
+#endif
+
 #endif /* __CORECRYPTO_CC_CONFIG_H__ */
